Options -Indexes

# a mídia é pública de propósito — é o que a API do Instagram baixa
<IfModule mod_headers.c>
  Header set Cache-Control "public, max-age=604800"
  Header set X-Robots-Tag "noindex"
</IfModule>

# mas nada de código executável aqui dentro
<FilesMatch "\.(php|phtml|php[0-9]|pl|py|cgi|sh|htaccess)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>
